[settings]
arch=x86_64
build_type=Release
compiler=gcc
compiler.version=13
compiler.cppstd=gnu23
compiler.libcxx=libstdc++11
os=Linux

[conf]
# Portable x86_64 baseline (SSE4.2 / POPCNT / CX16). Safe on every
# GitHub-hosted runner; using -march=native here would make the build
# host emit AVX2/AVX-512 that the test runner may not support and
# trigger SIGILL during gtest_discover_tests.
# Going through [conf] (not [buildenv] CXXFLAGS) is mandatory: only
# `tools.build:cflags` / `tools.build:cxxflags` are propagated by
# Conan's CMakeToolchain into CMAKE_C_FLAGS_INIT / CMAKE_CXX_FLAGS_INIT.
tools.build:cflags=["-O3", "-march=x86-64-v2"]
tools.build:cxxflags=["-O3", "-march=x86-64-v2"]
